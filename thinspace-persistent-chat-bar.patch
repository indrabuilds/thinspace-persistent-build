+final class ChatBarRimlessInteractionTests: XCTestCase {
+    @MainActor
+    func testPageIsEntirePanelAndOnlyModifierDragBecomesWindowMovement() {
+        _ = NSApplication.shared
+        let defaults = UserDefaults.standard
+        let oldProvider = defaults.object(forKey: LLMProvider.defaultsKey)
+        defer {
+            if let oldProvider { defaults.set(oldProvider, forKey: LLMProvider.defaultsKey) }
+            else { defaults.removeObject(forKey: LLMProvider.defaultsKey) }
+        }
+        let model = WebViewModel(provider: .chatgpt)
+        model.wkWebView.stopLoading()
+        var expansions = 0
+        let hostedContent = NSView()
+        let panel = ChatBarPanel(contentView: hostedContent, webViewModel: model,
+                                 onRequestDismiss: {}, onRequestExpand: { expansions += 1 })
+        defer { panel.dismissImmediately(); panel.close() }
+        XCTAssertTrue(panel.contentView === hostedContent, "No glass or other container surrounds the page")
+        XCTAssertEqual(hostedContent.frame.origin, .zero)
+        XCTAssertEqual(hostedContent.frame.size, panel.contentLayoutRect.size)
+        panel.presentAnimated()
+        func mouse(_ modifiers: NSEvent.ModifierFlags, window: NSWindow) -> NSEvent {
+            NSEvent.mouseEvent(with: .leftMouseDown, location: NSPoint(x: 100, y: 100),
+                modifierFlags: modifiers, timestamp: 0, windowNumber: window.windowNumber,
+                context: nil, eventNumber: 1, clickCount: 1, pressure: 1)!
+        }
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse([], window: panel)), "Normal webpage clicks must pass through")
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse(.command, window: panel)))
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse(.option, window: panel)))
+        XCTAssertTrue(panel.shouldHandleWindowDrag(mouse([.command, .option], window: panel)))
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse([.command, .option, .shift], window: panel)))
+        let other = NSWindow(contentRect: NSRect(x: 10, y: 10, width: 300, height: 200),
+                             styleMask: [.titled], backing: .buffered, defer: false)
+        other.isReleasedWhenClosed = false
+        defer { other.close() }
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse([.command, .option], window: other)),
+                       "The drag gesture must not affect other windows")
+        let shortcut = NSEvent.keyEvent(with: .keyDown, location: .zero,
+            modifierFlags: [.command, .shift], timestamp: 0, windowNumber: panel.windowNumber,
+            context: nil, characters: "\r", charactersIgnoringModifiers: "\r", isARepeat: false, keyCode: 36)!
+        XCTAssertTrue(panel.performKeyEquivalent(with: shortcut))
+        XCTAssertEqual(expansions, 1, "Command+Shift+Return opens full window")
+        panel.dismissImmediately()
+        XCTAssertFalse(panel.shouldHandleWindowDrag(mouse([.command, .option], window: panel)),
+                       "Hidden panels must not intercept mouse input")
+    }
+}
