+final class IdleRecoveryScriptTests: XCTestCase {
+    private func page() throws -> JSContext {
+        let c = try XCTUnwrap(JSContext())
+        c.evaluateScript("""
+        var clock = 10000000, errorShown = false, generating = false, files = false, quoted = false, assistantCount = 0;
+        Date.now = function () { return clock; };
+        var listeners = {};
+        var field = { value: 'unsent draft', tagName: 'TEXTAREA', querySelector: function () { return null; }, getClientRects: function () { return [1]; } };
+        var errorNode = { innerText: 'WritingBlockInvalidConversationError', getClientRects: function () { return [1]; }, closest: function () { return quoted ? {} : null; } };
+        function getComputedStyle() { return { visibility: 'visible' }; }
+        var document = {
+            addEventListener: function (type, callback) { (listeners[type] || (listeners[type] = [])).push(callback); },
+            querySelector: function () { return field; },
+            querySelectorAll: function (selector) {
+                if (selector.indexOf('data-message-author-role') >= 0) return Array(assistantCount).fill(errorNode);
+                if (selector.indexOf('stop-button') >= 0) return generating ? [errorNode] : [];
+                if (selector.indexOf('type="file"') >= 0) return files ? [{ files: [1] }] : [];
+                if (selector.indexOf('attachment') >= 0) return [];
+                return errorShown ? [errorNode] : [];
+            }
+        };
+        var window = { location: { href: 'https://chatgpt.com/' }, __thinspaceDetectedPrivateChatState: false, __thinspaceReadPrivateChatState: function () { return window.__thinspaceDetectedPrivateChatState; } };
+        function activity(type) { (listeners[type] || []).forEach(function (f) { f({ preventDefault: function () {} }); }); }
+        function eligible() { return window.__thinspaceIdleRecovery.snapshot().shouldRecover; }
+        function expired() { clock += 3601000; errorShown = true; eligible(); clock += 4000; }
+        """)
+        c.evaluateScript(UserScripts.idleRecoverySource)
+        XCTAssertNil(c.exception)
+        return c
+    }
+
+    func testHealthyPageNeverRefreshesAndFreshErrorDoesNotQualify() throws {
+        let c = try page()
+        c.evaluateScript("clock += 24 * 3600000;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        let fresh = try page()
+        fresh.evaluateScript("errorShown = true; eligible(); clock += 10000;")
+        XCTAssertFalse(fresh.evaluateScript("eligible()")!.toBool())
+    }
+
+    func testOnlyPersistentErrorAfterLongIdleQualifies() throws {
+        let c = try page()
+        c.evaluateScript("clock += 3601000; errorShown = true;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("clock += 4000;")
+        XCTAssertTrue(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("errorShown = false;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+    }
+
+    func testTypingCompositionRepliesAndAttachmentsBlockRecovery() throws {
+        let c = try page()
+        c.evaluateScript("expired(); activity('input');")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("clock += 9000; activity('compositionstart'); clock += 9000;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("activity('compositionend'); clock += 9000; generating = true;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("generating = false; files = true;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("files = false;")
+        XCTAssertTrue(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("window.__thinspaceDetectedPrivateChatState=null;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool(), "Unknown private mode must block automatic recovery")
+    }
+
+    func testNewPageInteractionCanCancelRestoration() throws {
+        let c = try page()
+        XCTAssertFalse(c.evaluateScript("window.__thinspaceIdleRecovery.snapshot().userInteracted")!.toBool())
+        c.evaluateScript("listeners.pointerdown[0]({isTrusted:true, type:'pointerdown'});")
+        XCTAssertTrue(c.evaluateScript("window.__thinspaceIdleRecovery.snapshot().userInteracted")!.toBool())
+    }
+
+    func testSuccessfulResponseAndNavigationEndTheIdleEpisode() throws {
+        let c = try page()
+        c.evaluateScript("expired(); errorShown=false; assistantCount=1; eligible(); errorShown=true; eligible(); clock+=4000;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        let moved = try page()
+        moved.evaluateScript("expired(); window.location.href='https://chatgpt.com/c/new'; eligible(); clock+=4000;")
+        XCTAssertFalse(moved.evaluateScript("eligible()")!.toBool())
+    }
+
+    func testQuotedErrorAndInterveningEditsDoNotTriggerReload() throws {
+        let c = try page()
+        c.evaluateScript("expired(); quoted = true;")
+        XCTAssertFalse(c.evaluateScript("eligible()")!.toBool())
+        c.evaluateScript("quoted = false; eligible(); clock += 4000;")
