+final class ChatBarPersistenceTests: XCTestCase {
+    @MainActor
+    func testPersistentDefaultAndLegacyPreferenceOnRecreatedPanel() {
+        _ = NSApplication.shared
+        let defaults = UserDefaults.standard
+        let key = UserDefaultsKeys.keepChatBarVisible.rawValue
+        let previousPreference = defaults.object(forKey: key)
+        let previousProvider = defaults.object(forKey: LLMProvider.defaultsKey)
+        defer {
+            if let previousPreference { defaults.set(previousPreference, forKey: key) }
+            else { defaults.removeObject(forKey: key) }
+            if let previousProvider { defaults.set(previousProvider, forKey: LLMProvider.defaultsKey) }
+            else { defaults.removeObject(forKey: LLMProvider.defaultsKey) }
+        }
+
+        let model = WebViewModel(provider: .chatgpt)
+        model.wkWebView.stopLoading()
+        func makePanel() -> ChatBarPanel {
+            ChatBarPanel(contentView: NSView(), webViewModel: model, onRequestDismiss: {})
+        }
+
+        defaults.removeObject(forKey: key)
+        let panel = makePanel()
+        XCTAssertFalse(panel.hidesOnDeactivate)
+        XCTAssertTrue(panel.isFloatingPanel)
+        XCTAssertEqual(panel.level, .floating)
+        XCTAssertFalse(panel.shouldDismissOnToggle)
+
+        // Changing the preference must not summon a hidden panel or take focus.
+        panel.setKeepChatBarVisible(false)
+        XCTAssertTrue(panel.hidesOnDeactivate)
+        XCTAssertFalse(panel.isVisible)
+        panel.setKeepChatBarVisible(true)
+        XCTAssertFalse(panel.hidesOnDeactivate)
+        XCTAssertFalse(panel.isVisible)
+
+        // A panel recreated after idle release must respect explicit false.
+        defaults.set(false, forKey: key)
+        let legacyPanel = makePanel()
+        XCTAssertTrue(legacyPanel.hidesOnDeactivate)
+        panel.dismissImmediately()
+        XCTAssertTrue(panel.isReleasableWhenIdle)
+        panel.close()
+        legacyPanel.close()
+    }
+}
