+final class ChatBarEdgeInteractionTests: XCTestCase {
+    @MainActor
+    func testExistingRimRoutesDragSurfaceAndDoubleClickWithoutCoveringContent() {
+        _ = NSApplication.shared
+        let defaults = UserDefaults.standard
+        let oldProvider = defaults.object(forKey: LLMProvider.defaultsKey)
+        defer {
+            if let oldProvider { defaults.set(oldProvider, forKey: LLMProvider.defaultsKey) }
+            else { defaults.removeObject(forKey: LLMProvider.defaultsKey) }
+        }
+        let model = WebViewModel(provider: .chatgpt)
+        model.wkWebView.stopLoading()
+        var expansions = 0
+        let hostedContent = NSView()
+        let panel = ChatBarPanel(contentView: hostedContent, webViewModel: model,
+                                 onRequestDismiss: {}, onRequestExpand: { expansions += 1 })
+        defer { panel.close() }
+        func descendants(_ view: NSView) -> [NSView] {
+            [view] + view.subviews.flatMap { descendants($0) }
+        }
+        guard let root = panel.contentView,
+              let edge = descendants(root).compactMap({ $0 as? ChatBarEdgeView }).first else {
+            XCTFail("Missing existing glass edge container")
+            return
+        }
+        XCTAssertTrue(edge.acceptsFirstMouse(for: nil), "The edge should respond while another app is active")
+        let rim = ChatBarPanel.Constants.glassRimWidth
+        XCTAssertEqual(hostedContent.frame.minX, rim, accuracy: 0.5)
+        XCTAssertEqual(hostedContent.frame.minY, rim, accuracy: 0.5)
+        XCTAssertEqual(hostedContent.frame.height, edge.bounds.height - 2 * rim, accuracy: 0.5)
+        let center = NSPoint(x: edge.bounds.midX, y: edge.bounds.midY)
+        let contentHit = edge.hitTest(edge.convert(center, to: edge.superview))
+        XCTAssertTrue(contentHit === hostedContent || contentHit?.isDescendant(of: hostedContent) == true)
+        let border = NSPoint(x: edge.bounds.midX, y: edge.bounds.maxY - rim / 2)
+        XCTAssertTrue(edge.hitTest(edge.convert(border, to: edge.superview)) === edge)
+        let event = NSEvent.mouseEvent(with: .leftMouseDown,
+            location: edge.convert(border, to: nil), modifierFlags: [], timestamp: 0,
+            windowNumber: panel.windowNumber, context: nil, eventNumber: 1, clickCount: 2, pressure: 1)!
+        edge.mouseDown(with: event)
+        XCTAssertEqual(expansions, 1, "Double-clicking the existing edge opens full window")
+        let shortcut = NSEvent.keyEvent(with: .keyDown, location: .zero,
+            modifierFlags: [.command, .shift], timestamp: 0, windowNumber: panel.windowNumber,
+            context: nil, characters: "\r", charactersIgnoringModifiers: "\r", isARepeat: false, keyCode: 36)!
+        XCTAssertTrue(panel.performKeyEquivalent(with: shortcut))
+        XCTAssertEqual(expansions, 2, "Command+Shift+Return opens full window")
+        XCTAssertEqual(edge.menu(for: event)?.items.first?.title, "Open Full Window")
+    }
+}
