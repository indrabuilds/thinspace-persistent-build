+final class IdleRecoveryWebKitTests: XCTestCase {
+    @MainActor
+    func testRealDOMErrorRecognitionAndDraftRestorationNeverSubmits() throws {
+        let web = WKWebView(frame: NSRect(x: 0, y: 0, width: 500, height: 300))
+        let delegate = IdleRecoveryNavigationDelegate()
+        let loaded = expectation(description: "local recovery fixture")
+        delegate.finished = { loaded.fulfill() }
+        web.navigationDelegate = delegate
+        web.loadHTMLString("""
+        <html><body><div role="alert">WritingBlockInvalidConversationError</div>
+        <form onsubmit="window.sends++; return false"><textarea id="prompt-textarea"></textarea><button>Send</button></form>
+        <script>window.sends = 0;</script></body></html>
+        """, baseURL: nil)
+        wait(for: [loaded], timeout: 10)
+        func evaluate(_ script: String) throws -> Any? {
+            let done = expectation(description: "evaluate recovery script")
+            var output: Any?, failure: Error?
+            web.evaluateJavaScript(script) { value, error in output = value; failure = error; done.fulfill() }
+            wait(for: [done], timeout: 5)
+            if let failure { throw failure }
+            return output
+        }
+        _ = try evaluate("window.clock=10000000; Date.now=function(){return window.clock;}; window.__thinspaceDetectedPrivateChatState=false; window.__thinspaceReadPrivateChatState=function(){return window.__thinspaceDetectedPrivateChatState;};" + UserScripts.idleRecoverySource)
+        _ = try evaluate("window.clock+=3601000; window.__thinspaceIdleRecovery.snapshot(); window.clock+=4000;")
+        let snapshot = try XCTUnwrap(try evaluate("window.__thinspaceIdleRecovery.snapshot()") as? [String: Any])
+        XCTAssertEqual(snapshot["shouldRecover"] as? Bool, true)
+        let draft = "draft with 'quotes' and a newline\nsecond line"
+        let json = String(data: try JSONSerialization.data(withJSONObject: draft, options: .fragmentsAllowed), encoding: .utf8)!
+        _ = try evaluate("window.__thinspaceIdleRecovery.restore(\(json), 'Draft restored; nothing sent.')")
+        _ = try evaluate("window.clock+=9000;")
+        XCTAssertEqual(try evaluate("window.__thinspaceIdleRecovery.restore(\(json), 'Draft restored; nothing sent.')") as? String, "restored")
+        XCTAssertEqual(try evaluate("document.querySelector('textarea').value") as? String, draft)
+        XCTAssertEqual(try evaluate("window.sends") as? Int, 0)
+        XCTAssertEqual(try evaluate("window.__thinspaceIdleRecovery.restore('another draft', 'notice')") as? String, "conflict")
+        XCTAssertEqual(try evaluate("document.querySelector('textarea').value") as? String, draft)
+        withExtendedLifetime(delegate) {}
+    }
+}
