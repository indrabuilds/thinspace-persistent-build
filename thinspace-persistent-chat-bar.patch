+final class ChatBarWebControlHitTests: XCTestCase {
+    @MainActor
+    func testNativeHeaderDoesNotCoverTheWebpagesTopRow() {
+        _ = NSApplication.shared
+        let defaults = UserDefaults.standard
+        let oldProvider = defaults.object(forKey: LLMProvider.defaultsKey)
+        defer {
+            if let oldProvider { defaults.set(oldProvider, forKey: LLMProvider.defaultsKey) }
+            else { defaults.removeObject(forKey: LLMProvider.defaultsKey) }
+        }
+        let model = WebViewModel(provider: .chatgpt)
+        model.wkWebView.stopLoading()
+        model.wkWebView.loadHTMLString("<html><body><button>Work</button></body></html>", baseURL: nil)
+        let host = NSHostingView(rootView: ChatBarView(webViewModel: model, onExpandToMain: {}))
+        let window = NSWindow(contentRect: NSRect(x: 100, y: 100, width: 500, height: 300),
+                              styleMask: [.titled], backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        host.sizingOptions = []
+        host.frame = NSRect(x: 0, y: 0, width: 500, height: 300)
+        host.autoresizingMask = [.width, .height]
+        window.contentView = host
+        window.setContentSize(NSSize(width: 500, height: 300))
+        NSApp.activate(ignoringOtherApps: true)
+        window.makeKeyAndOrderFront(nil)
+        let laidOut = expectation(description: "SwiftUI and WebKit layout")
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) { laidOut.fulfill() }
+        wait(for: [laidOut], timeout: 3)
+        host.layoutSubtreeIfNeeded()
+        defer { window.close(); model.wkWebView.stopLoading() }
+
+        func descendants(_ view: NSView) -> [NSView] {
+            [view] + view.subviews.flatMap { descendants($0) }
+        }
+        let dragViews = descendants(host).compactMap { $0 as? WindowDragNSView }
+        XCTAssertEqual(dragViews.count, 1)
+        let web = model.wkWebView
+        let webRect = host.convert(web.bounds, from: web)
+        print("Chat Bar hit-test geometry: host=\(host.bounds), web=\(webRect), attached=\(web.superview != nil)")
+        XCTAssertGreaterThan(webRect.height, 200)
+        for drag in dragViews {
+            let dragRect = host.convert(drag.bounds, from: drag)
+            XCTAssertGreaterThan(dragRect.width, 100)
+            XCTAssertFalse(dragRect.intersects(webRect), "Drag region must not overlap the provider page")
+        }
+        // Probe both the former central drag overlay and trailing expand area.
+        for x in [web.bounds.width * 0.5, web.bounds.width - 25] {
+            let topRow = NSPoint(x: x, y: web.isFlipped ? 20 : web.bounds.height - 20)
+            let point = host.convert(topRow, from: web)
+            let target = host.hitTest(point)
+            XCTAssertTrue(target === web || target?.isDescendant(of: web) == true,
+                          "Provider top-row clicks must reach WebKit")
+        }
+    }
+}
