+/// The existing transparent glass rim doubles as a window drag surface.
+/// Hit testing inside the content box always stays with the webpage.
+final class ChatBarEdgeView: NSView {
+    var onExpand: (() -> Void)?
+
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+
+    override func resetCursorRects() {
+        super.resetCursorRects()
+        let rim = ChatBarPanel.Constants.glassRimWidth
+        let corner = ChatBarPanel.Constants.cornerRadius
+        // Keep the resize corners on the system's ordinary cursor path.
+        addCursorRect(
+            NSRect(x: corner, y: bounds.maxY - rim,
+                   width: max(0, bounds.width - 2 * corner), height: rim),
+            cursor: .openHand
+        )
+        addCursorRect(
+            NSRect(x: corner, y: 0,
+                   width: max(0, bounds.width - 2 * corner), height: rim),
+            cursor: .openHand
+        )
+    }
+
+    override func mouseDown(with event: NSEvent) {
+        guard isOnEdge(event) else {
+            super.mouseDown(with: event)
+            return
+        }
+        if event.clickCount == 2 {
+            onExpand?()
+        } else {
+            window?.performDrag(with: event)
+        }
+    }
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        guard isOnEdge(event) else { return super.menu(for: event) }
+        let menu = NSMenu()
+        let expand = menu.addItem(withTitle: "Open Full Window", action: #selector(expandToFullWindow), keyEquivalent: "")
+        expand.target = self
+        return menu
+    }
+
+    private func isOnEdge(_ event: NSEvent) -> Bool {
+        let point = convert(event.locationInWindow, from: nil)
+        let rim = ChatBarPanel.Constants.glassRimWidth
+        return bounds.contains(point) && !bounds.insetBy(dx: rim, dy: rim).contains(point)
+    }
+
+    @objc private func expandToFullWindow() {
+        onExpand?()
+    }
+}
+
